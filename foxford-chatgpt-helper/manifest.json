{
  "manifest_version": 3,
  "name": "Разбор заданий Foxford → ChatGPT",
  "version": "2.1.0",
  "default_locale": "ru",
  "description": "Собирает задание на foxford.ru в промпт и сам вставляет его в открытый чат ChatGPT. Без API-ключей.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://foxford.ru/*",
    "https://*.foxford.ru/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://foxford.ru/*",
        "https://*.foxford.ru/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "chatgpt.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Разбор заданий Foxford → ChatGPT",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}