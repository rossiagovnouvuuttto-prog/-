plugins {
    id 'fabric-loom' version '1.14-SNAPSHOT'
}

version = project.mod_version
group = project.maven_group

base {
    archivesName = project.archives_base_name
}

repositories {
    maven {
        name = 'Fabric'
        url = uri('https://maven.fabricmc.net/')
    }
    mavenCentral()
}

dependencies {
    minecraft "com.mojang:minecraft:${project.minecraft_version}"
    mappings  "net.fabricmc:yarn:${project.yarn_mappings}:v2"
    modImplementation "net.fabricmc:fabric-loader:${project.loader_version}"
    modImplementation "net.fabricmc.fabric-api:fabric-api:${project.fabric_version}"
}

processResources {
    inputs.property 'version', project.version
    filesMatching('fabric.mod.json') {
        expand 'version': inputs.properties.version
    }
}

java {

}

tasks.withType(JavaCompile).configureEach {
    options.release = 21
    options.encoding = 'UTF-8'
    options.compilerArgs << '-Xmaxerrs' << '10000'
}

loom {
    // Loom >=1.6 remaps mixins itself; refmap generation is no longer needed.
    mixin {
        useLegacyMixinAp = false
    }

    runs {
        client {
            programArgs '--username', project.findProperty('mcName') ?: 'ABOBUS123_Test'
            vmArgs '-Xmx2G'
        }
    }
}

tasks.register('apiDump') {
    doLast {
        def cp = sourceSets.main.compileClasspath
        def loader = new URLClassLoader(cp.collect { it.toURI().toURL() } as URL[])
        def c = loader.loadClass(project.findProperty('cls') ?: 'net.minecraft.client.render.RenderLayer')
        c.declaredMethods.findAll { java.lang.reflect.Modifier.isStatic(it.modifiers) }
                         .collect { it.name }.unique().sort().each { println it }
        println '--- fields ---'
        c.declaredFields.findAll { java.lang.reflect.Modifier.isStatic(it.modifiers) }
                        .collect { it.name }.sort().each { println it }
    }
}
