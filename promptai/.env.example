# Скопируйте этот файл рядом под именем .env и вставьте свой ключ.
# Ключ создаётся кнопкой «Add API Key» на https://ollama.com/settings/keys
#
# ВАЖНО: файл .env не публикуется и не попадает в git — ключ должен
# оставаться только на вашем компьютере.

OLLAMA_API_KEY=здесь_ваш_ключ

# Какую модель просить писать промпты.
# Список облачных моделей: https://ollama.com/search?c=cloud
OLLAMA_MODEL=gpt-oss:120b-cloud

# Порт сайта (по умолчанию 4173)
# PORT=4173

# Адрес своей Ollama вместо облака — тогда ключ не нужен
# OLLAMA_HOST=http://localhost:11434
