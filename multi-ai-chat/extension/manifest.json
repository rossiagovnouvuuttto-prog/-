{
  "manifest_version": 3,
  "name": "Multi AI Chat",
  "version": "1.0.0",
  "description": "Чат с нейросетями Hugging Face: DeepSeek, Qwen, Llama, Mistral и другие.",
  "permissions": ["storage"],
  "host_permissions": ["https://router.huggingface.co/*"],
  "action": {
    "default_title": "Multi AI Chat",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background.js" }
}
