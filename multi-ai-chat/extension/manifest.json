{
  "manifest_version": 3,
  "name": "Multi AI Chat",
  "version": "1.0.0",
  "description": "Чат с облачными моделями Ollama: GPT-OSS, Qwen3 Coder, DeepSeek и другие.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://ollama.com/*"
  ],
  "action": {
    "default_title": "Multi AI Chat",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
