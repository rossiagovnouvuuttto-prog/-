# Hugging Face access token (read/inference scope is enough for chat).
# NEVER commit a real token. On Hugging Face Spaces add it under
# Settings -> Variables and secrets -> New secret, name: HF_TOKEN
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides
HF_BASE_URL=https://router.huggingface.co/v1
HF_TIMEOUT=120

# Optional: DeepSeek's own API, used by models with the "deepseek:" prefix.
# Get a key at https://platform.deepseek.com/api_keys (the API is paid).
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
