# Hugging Face access token (read/inference scope is enough for chat).
# NEVER commit a real token. On Hugging Face Spaces add it under
# Settings -> Variables and secrets -> New secret, name: HF_TOKEN
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides
HF_BASE_URL=https://router.huggingface.co/v1
HF_TIMEOUT=120
