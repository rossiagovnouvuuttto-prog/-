{
  "manifest_version": 3,
  "name": "Multi AI Chat — ChatGPT + DeepSeek",
  "version": "2.3.1",
  "description": "Чат через веб-версии ChatGPT и DeepSeek без API-ключей. Понятные ошибки вместо служебных сообщений Chrome.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.deepseek.com/*"
  ],
  "action": {
    "default_title": "Multi AI Chat",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
